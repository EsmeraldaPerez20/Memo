# Copia este archivo como ".env" y llena tus valores. El ".env" real NUNCA se sube a git.

# --- Django ---
SECRET_KEY=cambia-esto-por-una-llave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
# En produccion (Render): FORZAR_HTTPS=True y ALLOWED_HOSTS=tu-servicio.onrender.com
FORZAR_HTTPS=False

# --- Base de datos: Supabase > Project Settings > Database > Connection string > "Session pooler" ---
DB_NAME=postgres
DB_USER=postgres.TU_REF_DE_PROYECTO
DB_PASSWORD=la-contrasena-que-guardaste-al-crear-el-proyecto
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require

# --- Inteligencia artificial ---
# simulado = sin claves ni costo (para desarrollar). Cambia a anthropic u openai cuando tengas la clave.
IA_PROVEEDOR=simulado
IA_MODELO=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Los embeddings (busqueda en apuntes) necesitan OpenAI; con "simulado" el RAG funciona pero solo por palabras.
EMBEDDINGS_PROVEEDOR=simulado
EMBEDDING_MODELO=text-embedding-3-small
# Precio por millon de tokens, para estimar costos en consumo_ia (opcional)
IA_PRECIO_ENTRADA_USD_POR_M=0
IA_PRECIO_SALIDA_USD_POR_M=0

# --- Almacenamiento privado de archivos (Supabase Storage). Vacio = carpeta local (solo desarrollo) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documentos

# --- Inicio de sesion con Google (opcional) ---
GOOGLE_CLIENT_ID=

# --- Correo (recuperacion de contrasena y notificaciones). Por defecto imprime los correos en la consola ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Memo <no-reply@tu-dominio.com>

# --- Solo para correr las pruebas: base local con memo_schema.sql ya cargado, usada como plantilla ---
# TEST_DB_TEMPLATE=memo_template
